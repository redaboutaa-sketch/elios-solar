{
  "name": "elios-solar",
  "version": "0.1.0",
  "private": true,
  "description": "Boutique e-commerce de pergolas, stores bannes et accessoires avec configurateur (préproduction).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p 3400",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "VITEST_DB_SETUP=1 vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "media:heliostores": "tsx scripts/import-heliostores-media.ts",
    "catalogue:import": "tsx scripts/import-catalogue.ts",
    "supplier-prices:import": "tsx scripts/import-supplier-prices.ts",
    "tariffs:init": "tsx scripts/init-tariffs.ts",
    "mail:worker": "tsx scripts/mail-worker.ts",
    "renders:generate": "tsx scripts/generate-renders.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.11",
    "dotenv": "^18.0.8",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "stripe": "23.0.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
