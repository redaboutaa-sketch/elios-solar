generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* ------------------------------------------------------------------ */
/* Authentification (better-auth)                                      */
/* ------------------------------------------------------------------ */

enum UserRole {
  CUSTOMER
  MANAGER
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(CUSTOMER)
  phone         String?
  marketingOptIn Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  addresses     Address[]
  configurations Configuration[]
  carts         Cart[]
  orders        Order[]
  quotes        Quote[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/* ------------------------------------------------------------------ */
/* Paramètres du site / identité                                       */
/* ------------------------------------------------------------------ */

model SiteSettings {
  id                   Int      @id @default(1)
  brandName            String   @default("ELIOS SOLAR")
  brandNameProvisional Boolean  @default(true)
  legalName            String?
  legalForm            String?
  siret                String?
  vatNumber            String?
  shareCapital         String?
  rcsCity              String?
  addressLine1         String?
  addressLine2         String?
  postalCode           String?
  city                 String?
  countryCode          String   @default("FR")
  phone                String?
  contactEmail         String?
  domain               String?
  logoMediaId          String?
  faviconMediaId       String?
  defaultTaxRateBps    Int      @default(2000)
  indexable            Boolean  @default(false)
  analyticsEnabled     Boolean  @default(false)
  analyticsScriptUrl   String?
  updatedAt            DateTime @updatedAt
}

/* ------------------------------------------------------------------ */
/* Catalogue                                                           */
/* ------------------------------------------------------------------ */

enum DataStatus {
  DEMO
  SUPPLIER_VERIFIED
  OBSERVED
  UNKNOWN
}

enum FamilyKind {
  PERGOLA_STANDARD
  PERGOLA_CUSTOM
  AWNING
  SIDE_CLOSURE
  OPTION
  SERVICE
}

enum FamilyStatus {
  DRAFT
  PUBLISHED
  QUOTE_ONLY
  ARCHIVED
}

enum Mounting {
  FREESTANDING
  WALL
}

enum CompatStatus {
  ALLOWED
  FORBIDDEN
  UNKNOWN
}

enum StockMode {
  STOCK
  MADE_TO_ORDER
}

model Finish {
  code           String  @id
  label          String
  structureColor String
  bladeColor     String
  swatch         String
  sortOrder      Int     @default(0)
  families       FamilyFinish[]
}

model DimensionPreset {
  code      String @id
  label     String
  widthMm   Int
  lengthMm  Int
  sortOrder Int    @default(0)
  families  FamilyDimension[]
}

model ProductFamily {
  id                 String        @id @default(cuid())
  slug               String        @unique
  name               String
  kind               FamilyKind
  status             FamilyStatus  @default(DRAFT)
  generation         String?
  shortDescription   String        @default("")
  description        String        @default("")
  roof               String?
  lightingIncluded   String?
  accessoryRails     Int?
  dividerThresholdMm Int?
  mountings          Mounting[]
  specs              Json          @default("[]")
  faq                Json          @default("[]")
  included           Json          @default("[]")
  dataStatus         DataStatus    @default(DEMO)
  sortOrder          Int           @default(0)
  seoTitle           String?
  seoDescription     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  finishes           FamilyFinish[]
  dimensions         FamilyDimension[]
  variants           Variant[]
  media              ProductMedia[]
  documents          Document[]
}

model FamilyFinish {
  familyId   String
  finishCode String
  family     ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  finish     Finish        @relation(fields: [finishCode], references: [code], onDelete: Cascade)

  @@id([familyId, finishCode])
}

model FamilyDimension {
  familyId      String
  dimensionCode String
  family        ProductFamily   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  dimension     DimensionPreset @relation(fields: [dimensionCode], references: [code], onDelete: Cascade)

  @@id([familyId, dimensionCode])
}

model Variant {
  id             String     @id @default(cuid())
  sku            String     @unique
  familyId       String
  family         ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  label          String
  priceCents     Int
  compareAtCents Int?
  taxRateBps     Int        @default(2000)
  purchasable    Boolean    @default(false)
  dataStatus     DataStatus @default(DEMO)
  stockMode      StockMode  @default(MADE_TO_ORDER)
  stockQty       Int?
  reservedQty    Int        @default(0)
  leadTimeDays   Int?
  weightGrams    Int?
  attributes     Json
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  reservations   StockReservation[]

  @@index([familyId])
}

model ClosureCompatRule {
  id                String       @id @default(cuid())
  closureFamilySlug String
  pergolaFamilySlug String       @default("*")
  segmentLengthMm   Int?
  pergolaFinishCode String       @default("*")
  mounting          String       @default("*")
  status            CompatStatus
  reason            String?
  dataStatus        DataStatus   @default(DEMO)
  updatedAt         DateTime     @updatedAt

  @@index([closureFamilySlug, pergolaFamilySlug])
}

model OptionCompatRule {
  id                String       @id @default(cuid())
  optionFamilySlug  String
  pergolaFamilySlug String       @default("*")
  status            CompatStatus
  includedInBase    Boolean      @default(false)
  maxQty            Int?
  reason            String?
  dataStatus        DataStatus   @default(DEMO)
  updatedAt         DateTime     @updatedAt

  @@unique([optionFamilySlug, pergolaFamilySlug])
}

model InstallationRate {
  id            String     @id @default(cuid())
  familySlug    String
  dimensionCode String?
  priceCents    Int
  dataStatus    DataStatus @default(DEMO)
  updatedAt     DateTime   @updatedAt

  @@index([familySlug])
}

model ShippingRule {
  id             String   @id @default(cuid())
  countryCode    String   @default("FR")
  postalPrefixes String[]
  priceCents     Int
  label          String
  quoteRequired  Boolean  @default(false)
  sortOrder      Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model Promotion {
  id          String    @id @default(cuid())
  code        String?   @unique
  label       String
  familySlugs String[]
  allFamilies Boolean   @default(false)
  percentBps  Int
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CustomPergolaSettings {
  id          Int        @id @default(1)
  quoteOnly   Boolean    @default(true)
  widthMinMm  Int        @default(2000)
  widthMaxMm  Int        @default(4000)
  widthStepMm Int        @default(10)
  lengthMinMm Int        @default(2000)
  lengthMaxMm Int        @default(6000)
  lengthStepMm Int       @default(10)
  heightMinMm Int        @default(2200)
  heightMaxMm Int        @default(3000)
  heightStepMm Int       @default(10)
  dataStatus  DataStatus @default(UNKNOWN)
  updatedAt   DateTime   @updatedAt
}

/* ------------------------------------------------------------------ */
/* Médias & documents                                                  */
/* ------------------------------------------------------------------ */

model Media {
  id         String   @id @default(cuid())
  kind       String   @default("image")
  path       String
  alt        String   @default("")
  width      Int?
  height     Int?
  mimeType   String?
  sizeBytes  Int?
  source     String   @default("")
  license    String   @default("")
  credit     String   @default("")
  createdAt  DateTime @default(now())
  products   ProductMedia[]
  documents  Document[]
  realisations Realisation[]
}

model ProductMedia {
  id        String        @id @default(cuid())
  familyId  String
  mediaId   String
  role      String        @default("gallery")
  caption   String        @default("")
  sortOrder Int           @default(0)
  family    ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  media     Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

model Document {
  id         String         @id @default(cuid())
  familyId   String?
  mediaId    String?
  title      String
  kind       String         @default("notice")
  dataStatus DataStatus     @default(UNKNOWN)
  family     ProductFamily? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  media      Media?         @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())
}

/* ------------------------------------------------------------------ */
/* Configurations, paniers, devis, commandes                           */
/* ------------------------------------------------------------------ */

enum ConfigurationStatus {
  DRAFT
  VALID
  NEEDS_REVIEW
  QUOTE_REQUIRED
}

model Configuration {
  id              String              @id @default(cuid())
  shareToken      String              @unique
  shareRevoked    Boolean             @default(false)
  ownerUserId     String?
  owner           User?               @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  guestKey        String?
  kind            String
  title           String?
  version         Int                 @default(1)
  engineVersion   String
  catalogVersion  String
  input           Json
  result          Json
  status          ConfigurationStatus @default(DRAFT)
  parentId        String?
  lastValidatedAt DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  cartLines       CartLine[]
  quotes          Quote[]

  @@index([ownerUserId])
  @@index([guestKey])
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model Cart {
  id            String     @id @default(cuid())
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestKey      String?
  status        CartStatus @default(ACTIVE)
  promotionCode String?
  delivery      Json?
  lines         CartLine[]
  orders        Order[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
  @@index([guestKey])
}

model CartLine {
  id              String         @id @default(cuid())
  cartId          String
  cart            Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  configurationId String?
  configuration   Configuration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  input           Json
  qty             Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String  @default("")
  firstName  String
  lastName   String
  company    String?
  line1      String
  line2      String?
  postalCode String
  city       String
  countryCode String @default("FR")
  phone      String?
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())
}

enum QuoteStatus {
  NEW
  IN_REVIEW
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model Quote {
  id              String         @id @default(cuid())
  number          String         @unique
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  firstName       String
  lastName        String
  phone           String?
  postalCode      String?
  message         String?
  kind            String
  configurationId String?
  configuration   Configuration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  snapshot        Json
  status          QuoteStatus    @default(NEW)
  validUntil      DateTime?
  adminNotes      String?
  proposedTotalCents Int?
  containsDemoData Boolean       @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([email])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  EXPIRED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                String            @id @default(cuid())
  number            String            @unique
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestKey          String?
  email             String
  status            OrderStatus       @default(PENDING_PAYMENT)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  currency          String            @default("EUR")
  goodsCents        Int
  installationCents Int               @default(0)
  shippingCents     Int               @default(0)
  discountCents     Int               @default(0)
  taxCents          Int
  totalCents        Int
  shippingAddress   Json
  billingAddress    Json
  delivery          Json
  isDemo            Boolean           @default(true)
  containsDemoData  Boolean           @default(true)
  customerNotes     String?
  adminNotes        String?
  cartId            String?
  cart              Cart?             @relation(fields: [cartId], references: [id], onDelete: SetNull)
  lines             OrderLine[]
  payments          Payment[]
  reservations      StockReservation[]
  expiresAt         DateTime?
  paidAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([email])
  @@index([status])
}

model OrderLine {
  id                    String  @id @default(cuid())
  orderId               String
  order                 Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind                  String
  sku                   String?
  label                 String
  qty                   Int
  unitGrossCents        Int
  totalGrossCents       Int
  taxRateBps            Int
  included              Boolean @default(false)
  configurationSnapshot Json?
  sortOrder             Int     @default(0)
}

enum PaymentProvider {
  DEMO
  STRIPE
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      PaymentProvider
  providerRef   String?         @unique
  status        PaymentStatus   @default(CREATED)
  amountCents   Int
  currency      String          @default("EUR")
  checkoutUrl   String?
  failureReason String?
  events        PaymentEvent[]
  refunds       Refund[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([orderId])
}

model PaymentEvent {
  id          String          @id @default(cuid())
  paymentId   String?
  payment     Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider    PaymentProvider
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  outcome     String?
  receivedAt  DateTime        @default(now())

  @@unique([provider, eventId])
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountCents Int
  reason      String?
  status      String   @default("PENDING")
  providerRef String?
  createdAt   DateTime @default(now())
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

model StockReservation {
  id        String            @id @default(cuid())
  variantId String
  variant   Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  qty       Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([variantId, status])
  @@index([orderId])
}

/* ------------------------------------------------------------------ */
/* Notifications, contacts, consentements, journal                     */
/* ------------------------------------------------------------------ */

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

model EmailOutbox {
  id            String       @id @default(cuid())
  dedupeKey     String?      @unique
  toEmail       String
  subject       String
  template      String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  nextAttemptAt DateTime     @default(now())
  sentAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt])
}

model ContactRequest {
  id            String   @id @default(cuid())
  kind          String   @default("contact")
  name          String
  email         String
  phone         String?
  message       String?
  preferredSlot String?
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
}

model Consent {
  id        String   @id @default(cuid())
  guestKey  String?
  userId    String?
  necessary Boolean  @default(true)
  analytics Boolean  @default(false)
  marketing Boolean  @default(false)
  version   String
  createdAt DateTime @default(now())

  @@index([guestKey])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String?
  action      String
  entity      String
  entityId    String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/* ------------------------------------------------------------------ */
/* Contenus                                                            */
/* ------------------------------------------------------------------ */

model ContentPage {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  body          String   @default("")
  status        String   @default("DRAFT")
  missingFields Json     @default("[]")
  updatedAt     DateTime @updatedAt
}

model Realisation {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  location    String?
  familySlug  String?
  mediaId     String?
  media       Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  published   Boolean  @default(false)
  isDemo      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Showroom {
  id         String  @id @default(cuid())
  name       String
  line1      String
  postalCode String
  city       String
  hours      String  @default("")
  phone      String?
  published  Boolean @default(false)
  isDemo     Boolean @default(true)
}

model CatalogImport {
  id          String   @id @default(cuid())
  filename    String
  status      String   @default("PREVIEW")
  summary     Json
  errors      Json     @default("[]")
  createdBy   String?
  createdAt   DateTime @default(now())
}
