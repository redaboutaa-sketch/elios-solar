// ---------------------------------------------------------------------------
// Itération 4 : données techniques sourcées, validation des références, visuels de devis
// ---------------------------------------------------------------------------

/**
 * Provenance d'une valeur technique : seule SUPPLIER_CONFIRMED est présentée publiquement comme certaine.
 */
enum SpecSource {
  DEMO_SEED
  OBSERVED_REFERENCE
  SUPPLIER_CONFIRMED
  /// fiche technique du modèle exact transmise par le client
  CLIENT_SHEET
  /// catalogue ou document technique du fournisseur / fabricant
  SUPPLIER_DOCUMENT
  /// page officielle du fabricant
  MANUFACTURER_WEBSITE
}

/**
 * Valeur technique avec sa source (plusieurs lignes possibles par clé : démo, observation, confirmation).
 */
model TechnicalSpec {
  id         String        @id @default(cuid())
  familyId   String
  family     ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  variantSku String?
  key        String
  label      String
  valueNum   Int?
  unit       String?
  valueText  String?
  source     SpecSource
  sourceRef  String        @default("")
  documentId String?
  document   Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  observedAt DateTime?
  note       String        @default("")
  createdBy  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([familyId, key])
}

enum ValidationTarget {
  VARIANT
  FAMILY_SPEC
  CLOSURE_RULE
  OPTION_RULE
}

enum ValidationStatus {
  DRAFT
  TO_REVIEW
  VALIDATED
  REJECTED
}

enum ValidationSourceKind {
  SUPPLIER_DOCUMENT
  SUPPLIER_WRITTEN
  OBSERVED_REFERENCE
  OTHER
}

/**
 * Dossier de validation : données proposées pour une cible, rattachées à une version précise (baseHash) des données actuelles.
 */
model ReferenceValidation {
  id           String                     @id @default(cuid())
  targetType   ValidationTarget
  targetId     String
  targetLabel  String
  familySlug   String?
  baseData     Json
  baseHash     String
  proposed     Json
  sourceKind   ValidationSourceKind?
  sourceUrl    String?
  documentId   String?
  document     Document?                  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sourceNote   String                     @default("")
  status       ValidationStatus           @default(DRAFT)
  createdById  String?
  createdBy    User?                      @relation("validationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  decidedById  String?
  decidedBy    User?                      @relation("validationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  appliedHash  String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  events       ReferenceValidationEvent[]

  @@index([targetType, targetId])
  @@index([status])
}

model ReferenceValidationEvent {
  id           String              @id @default(cuid())
  validationId String
  validation   ReferenceValidation @relation(fields: [validationId], references: [id], onDelete: Cascade)
  fromStatus   ValidationStatus?
  toStatus     ValidationStatus
  actorId      String?
  actorEmail   String?
  note         String?
  dataHash     String?
  createdAt    DateTime            @default(now())

  @@index([validationId])
}

enum VisualKind {
  SCENE_3D
  PLAN_2D
}

/**
 * Visualisation jointe à un devis : figée à l'émission, rattachée à une version précise de configuration.
 */
model QuoteVisual {
  id                   String         @id @default(cuid())
  quoteId              String
  quote                Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  configurationId      String?
  configuration        Configuration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  configurationVersion Int?
  inputHash            String
  kind                 VisualKind     @default(SCENE_3D)
  storageKey           String
  mime                 String
  bytes                Int
  width                Int
  height               Int
  represented          Json           @default("[]")
  disclaimer           String
  createdAt            DateTime       @default(now())

  @@index([quoteId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Tarifs fournisseur — PRIVÉS (jamais dans l'instantané public)
 */
/**
 * ------------------------------------------------------------------
 */

enum PriceNature {
  /// nature non établie : ni prix de vente, ni prix d'achat confirmé
  UNKNOWN
  PURCHASE
  SALE
  RECOMMENDED
  EXAMPLE
}

enum TaxBasis {
  UNKNOWN
  HT
  TTC
}

enum PriceListStatus {
  /// importée, en revue (grille : brouillon modifiable)
  DRAFT
  /// grille contrôlée, prête à publier (toute modification la ramène en brouillon)
  VERIFIED
  /// version de référence (une seule active par source)
  ACTIVE
  ARCHIVED
  REJECTED
}

/// IMPORT = version d'un fichier importé (classeur, fiche) ; GRID = grille tarifaire administrée (une famille, une variante)
enum PriceListScope {
  IMPORT
  GRID
}

/// Clientèle visée par une grille ; ALL = toutes (seules ALL et PARTICULIER alimentent la boutique)
enum PriceClientele {
  ALL
  PARTICULIER
  PROFESSIONNEL
}

/// Lecture d'une cote : EXACT = la cote doit être une dimension de la grille ; ROUND_UP = dimension supérieure (règle à confirmer)
enum GridDimRule {
  EXACT
  ROUND_UP
}

enum PriceRowStatus {
  OK
  TO_CHECK
  REJECTED
}

/// Version importée d'un tarif fournisseur (classeur, fiche). Les montants restent internes tant que leur nature n'est pas établie.
model SupplierPriceList {
  id           String             @id @default(cuid())
  /// identifiant stable de la source (ex. « situation-des-tarifs ») ; les versions se succèdent
  sourceKey    String
  version      Int
  label        String
  sourceFile   String
  sourceSha256 String
  status       PriceListStatus    @default(DRAFT)
  /// devise indiquée par la source (code ISO, ex. MAD) ; null = non indiquée
  currency     String?
  currencyNote String             @default("")
  taxBasis     TaxBasis           @default(UNKNOWN)
  nature       PriceNature        @default(UNKNOWN)
  natureNote   String             @default("")
  validFrom    DateTime?
  validTo      DateTime?
  /// feuilles analysées, formules, contrôles, rapport d'import (lignes intégrées / à vérifier / rejetées)
  report       Json               @default("{}")
  notes        String             @default("")
  importedBy   String?
  activatedBy  String?
  activatedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  rows         SupplierPriceRow[]

  // --- grille tarifaire administrée (scope = GRID) ---
  scope         PriceListScope @default(IMPORT)
  /// famille et variante tarifaires couvertes (GRID)
  familySlug    String?
  variantKey    String         @default("")
  /// colonne d'origine (PRIX_FINAL, PRIX_SOURCE, MANUAL)
  amountRole    String?
  clientele     PriceClientele @default(ALL)
  /// taux de TVA appliqué à un prix HT (points de base) ; null = taux du catalogue
  vatRateBps    Int?
  dimRule       GridDimRule    @default(EXACT)
  /// justification d'une règle de lecture ROUND_UP (obligatoire pour publier)
  dimRuleNote   String         @default("")
  /// implantations / variantes concernées (texte libre affiché aux administrateurs)
  scopeNote     String         @default("")
  included      String         @default("")
  excluded      String         @default("")
  /// version importée d'où viennent les cellules
  originListId  String?
  /// version reprise (« reprendre en brouillon », recalcul)
  basedOnId     String?
  /// version en vigueur du même contexte quand le brouillon a été créé (détection d'un brouillon obsolète)
  baseActiveId  String?
  /// compteur de modifications (verrou optimiste)
  revision      Int            @default(0)
  zeroConfirmed Boolean        @default(false)
  verifiedAt    DateTime?
  verifiedBy    String?
  publishedAt   DateTime?
  publishedBy   String?
  deactivatedAt DateTime?
  deactivatedBy String?

  @@unique([sourceKey, version])
  @@index([sourceKey, status])
  @@index([scope, familySlug, status])
}

/// Ligne de tarif : montant d'une cellule précise, avec sa provenance et ses contrôles.
model SupplierPriceRow {
  id          String            @id @default(cuid())
  listId      String
  list        SupplierPriceList @relation(fields: [listId], references: [id], onDelete: Cascade)
  familySlug  String
  /// variante tarifaire telle que nommée par la source (ex. « autoportante », « murale », « module suivant »)
  variantKey  String            @default("")
  /// GRID = produit à la dimension ; OPTION = équipement / supplément
  kind        String            @default("GRID")
  code        String            @default("")
  label       String            @default("")
  /// dimension principale (projection, hauteur…) et plage de largeur couvertes, en mm
  dimAKey     String?
  dimAmm      Int?
  widthMinMm  Int?
  widthMaxMm  Int?
  /// conditions d'application (plages, unité, remise, « non remisé »…)
  conditions  Json              @default("{}")
  /// montant en unités mineures (centimes) de `currency` ; null = cellule vide (jamais zéro par défaut)
  amountMinor Int?
  currency    String?
  /// colonne / nature de la valeur dans la source (ex. « C Prix », « F Prix final HELIOSTORES »)
  amountRole  String
  /// formule source et valeur en cache, quand la cellule est calculée
  formula     String?
  cachedValue Float?
  sourceRef   String
  status      PriceRowStatus    @default(TO_CHECK)
  issues      String[]          @default([])
  createdAt   DateTime          @default(now())
  /// IMPORT = cellule lue dans un fichier ; MANUAL = saisie dans l'administration
  origin      String            @default("IMPORT")
  editedBy    String?
  editedAt    DateTime?

  @@index([listId, familySlug])
}

/// Téléversement d'un classeur ou d'une fiche depuis l'administration : fichiers privés gardés en base le temps de
/// l'analyse, effacés après l'import ou l'abandon (seules l'empreinte et les métadonnées restent).
model PriceImportUpload {
  id         String            @id @default(cuid())
  status     String            @default("ANALYSED")
  createdBy  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  /// correspondances corrigées par l'administrateur (feuille/bloc → famille/variante, colonnes → nature)
  mapping    Json              @default("{}")
  /// résultat de l'import (versions et grilles créées)
  result     Json              @default("{}")
  importedAt DateTime?
  files      PriceImportFile[]
}

model PriceImportFile {
  id        String            @id @default(cuid())
  uploadId  String
  upload    PriceImportUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  fileName  String
  sha256    String
  size      Int
  /// contenu (vidé après import ou abandon)
  bytes     Bytes?

  @@index([uploadId])
}
