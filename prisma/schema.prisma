generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Authentification (better-auth)
 */
/**
 * ------------------------------------------------------------------
 */

enum UserRole {
  CUSTOMER
  MANAGER
  ADMIN
}

model User {
  id                 String                @id
  name               String
  email              String
  emailVerified      Boolean               @default(false)
  image              String?
  role               UserRole              @default(CUSTOMER)
  phone              String?
  marketingOptIn     Boolean               @default(false)
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  sessions           Session[]
  accounts           Account[]
  addresses          Address[]
  configurations     Configuration[]
  carts              Cart[]
  orders             Order[]
  quotes             Quote[]
  conversations      Conversation[]
  lastSeenAt         DateTime?
  validationsCreated ReferenceValidation[] @relation("validationCreatedBy")
  validationsDecided ReferenceValidation[] @relation("validationDecidedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Paramètres du site / identité
 */
/**
 * ------------------------------------------------------------------
 */

model SiteSettings {
  id                   Int      @id @default(1)
  brandName            String   @default("ELIOS SOLAR")
  brandNameProvisional Boolean  @default(true)
  legalName            String?
  legalForm            String?
  siret                String?
  vatNumber            String?
  shareCapital         String?
  rcsCity              String?
  addressLine1         String?
  addressLine2         String?
  postalCode           String?
  city                 String?
  countryCode          String   @default("FR")
  phone                String?
  contactEmail         String?
  domain               String?
  logoMediaId          String?
  faviconMediaId       String?
  defaultTaxRateBps    Int      @default(2000)
  indexable            Boolean  @default(false)
  analyticsEnabled     Boolean  @default(false)
  analyticsScriptUrl   String?
  /**
   * GROUPED = expédition groupée au délai le plus long ; SEPARATE = chaque référence part dès disponibilité
   */
  shipmentPolicy       String   @default("GROUPED")
  chatEnabled          Boolean  @default(true)
  chatOfflineMessage   String   @default("")
  updatedAt            DateTime @updatedAt
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Catalogue
 */
/**
 * ------------------------------------------------------------------
 */

enum DataStatus {
  DEMO
  SUPPLIER_VERIFIED
  OBSERVED
  UNKNOWN
}

enum FamilyKind {
  PERGOLA_STANDARD
  PERGOLA_CUSTOM
  AWNING
  SIDE_CLOSURE
  OPTION
  SERVICE
  /// systèmes configurables à la cote (catalogue HELIOSTORES) : règles sourcées dans `systemRules`
  PERGOLA_SYSTEM
  SCREEN_SYSTEM
  AWNING_SYSTEM
  ROOF_BLIND_SYSTEM
  /// moustiquaires (quatrième famille, 2026-10-25)
  INSECT_SCREEN_SYSTEM
}

/// Les trois familles publiques du catalogue HELIOSTORES (navigation principale).
enum ProductCategory {
  PERGOLAS
  SCREENS
  STORES_BANNES
  MOUSTIQUAIRES
}

enum FamilyStatus {
  DRAFT
  PUBLISHED
  QUOTE_ONLY
  ARCHIVED
}

enum Mounting {
  FREESTANDING
  WALL
}

enum CompatStatus {
  ALLOWED
  FORBIDDEN
  UNKNOWN
}

enum StockMode {
  STOCK
  MADE_TO_ORDER
}

model Finish {
  code           String         @id
  label          String
  structureColor String
  bladeColor     String
  swatch         String
  sortOrder      Int            @default(0)
  families       FamilyFinish[]
}

model DimensionPreset {
  code      String            @id
  label     String
  widthMm   Int
  lengthMm  Int
  sortOrder Int               @default(0)
  families  FamilyDimension[]
}

model ProductFamily {
  id                 String            @id @default(cuid())
  slug               String            @unique
  name               String
  kind               FamilyKind
  status             FamilyStatus      @default(DRAFT)
  generation         String?
  shortDescription   String            @default("")
  description        String            @default("")
  roof               String?
  lightingIncluded   String?
  accessoryRails     Int?
  dividerThresholdMm Int?
  mountings          Mounting[]
  specs              Json              @default("[]")
  faq                Json              @default("[]")
  included           Json              @default("[]")
  dataStatus         DataStatus        @default(DEMO)
  sortOrder          Int               @default(0)
  /// famille publique (Pergolas, Screens, Stores bannes) ; null = hors navigation (ancien catalogue, brouillon)
  category           ProductCategory?
  /// marque commerciale, fabricant du système et référence exacte, quand ils sont établis par une source
  brand              String?
  manufacturer       String?
  supplierRef        String?
  /// règles du configurateur (dimensions, implantations, options, inclus) avec leurs sources — voir src/domain/system.ts
  systemRules        Json?
  /// questions ouvertes bloquant une décision (texte + champ concerné + sources)
  openQuestions      Json              @default("[]")
  /// ancien produit de démonstration conservé pour l'historique des devis, projets et commandes
  legacy             Boolean           @default(false)
  seoTitle           String?
  seoDescription     String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  finishes           FamilyFinish[]
  dimensions         FamilyDimension[]
  variants           Variant[]
  media              ProductMedia[]
  documents          Document[]
  technicalSpecs     TechnicalSpec[]
  /// anciens slugs publics (redirections permanentes, liens enregistrés)
  legacySlugs        String[]          @default([])
  /// historique des noms commerciaux : [{ name, until, by, note }]
  nameHistory        Json              @default("[]")
  /// dernière modification des textes commerciaux dans l'administration (le seed ne les écrase plus)
  commercialEditedAt DateTime?
}

model FamilyFinish {
  familyId   String
  finishCode String
  family     ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  finish     Finish        @relation(fields: [finishCode], references: [code], onDelete: Cascade)

  @@id([familyId, finishCode])
}

model FamilyDimension {
  familyId      String
  dimensionCode String
  family        ProductFamily   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  dimension     DimensionPreset @relation(fields: [dimensionCode], references: [code], onDelete: Cascade)

  @@id([familyId, dimensionCode])
}

model Variant {
  id                   String             @id @default(cuid())
  sku                  String             @unique
  familyId             String
  family               ProductFamily      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  label                String
  priceCents           Int
  compareAtCents       Int?
  taxRateBps           Int                @default(2000)
  purchasable          Boolean            @default(false)
  dataStatus           DataStatus         @default(DEMO)
  stockMode            StockMode          @default(MADE_TO_ORDER)
  stockQty             Int?
  reservedQty          Int                @default(0)
  leadTimeDays         Int?
  weightGrams          Int?
  attributes           Json
  active               Boolean            @default(true)
  /**
   * Disponibilité et délais par référence (itération 3)
   */
  availability         Availability       @default(TO_CONFIRM)
  leadMinDays          Int?
  leadMaxDays          Int?
  leadUnit             LeadUnit           @default(BUSINESS_DAYS)
  leadSource           DataStatus         @default(UNKNOWN)
  leadUpdatedAt        DateTime?
  supplierDays         Int?
  preparationDays      Int?
  productionDays       Int?
  transportDays        Int?
  preorderAllowed      Boolean            @default(false)
  partialShipAllowed   Boolean            @default(true)
  stockSource          String             @default("")
  stockUpdatedAt       DateTime?
  /**
   * Validation administrative avec source documentaire
   */
  validationSource     String?
  validationDocumentId String?
  validatedBy          String?
  validatedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  reservations         StockReservation[]
  movements            StockMovement[]

  @@index([familyId])
}

enum Availability {
  AVAILABLE
  ON_ORDER
  OUT_OF_STOCK
  TO_CONFIRM
}

enum LeadUnit {
  BUSINESS_DAYS
  CALENDAR_DAYS
  WEEKS
}

/**
 * Journal des mouvements de stock (saisie admin, import, correction).
 */
model StockMovement {
  id        String   @id @default(cuid())
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  reference String?
  actor     String?
  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
}

model ClosureCompatRule {
  id                String       @id @default(cuid())
  closureFamilySlug String
  pergolaFamilySlug String       @default("*")
  segmentLengthMm   Int?
  pergolaFinishCode String       @default("*")
  mounting          String       @default("*")
  status            CompatStatus
  reason            String?
  dataStatus        DataStatus   @default(DEMO)
  updatedAt         DateTime     @updatedAt

  @@index([closureFamilySlug, pergolaFamilySlug])
}

model OptionCompatRule {
  id                String       @id @default(cuid())
  optionFamilySlug  String
  pergolaFamilySlug String       @default("*")
  status            CompatStatus
  includedInBase    Boolean      @default(false)
  maxQty            Int?
  reason            String?
  dataStatus        DataStatus   @default(DEMO)
  updatedAt         DateTime     @updatedAt

  @@unique([optionFamilySlug, pergolaFamilySlug])
}

model InstallationRate {
  id            String     @id @default(cuid())
  familySlug    String
  dimensionCode String?
  priceCents    Int
  dataStatus    DataStatus @default(DEMO)
  updatedAt     DateTime   @updatedAt

  @@index([familySlug])
}

model ShippingRule {
  id             String   @id @default(cuid())
  countryCode    String   @default("FR")
  postalPrefixes String[]
  priceCents     Int
  label          String
  quoteRequired  Boolean  @default(false)
  sortOrder      Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model Promotion {
  id          String    @id @default(cuid())
  code        String?   @unique
  label       String
  familySlugs String[]
  allFamilies Boolean   @default(false)
  percentBps  Int
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CustomPergolaSettings {
  id           Int        @id @default(1)
  quoteOnly    Boolean    @default(true)
  widthMinMm   Int        @default(2000)
  widthMaxMm   Int        @default(4000)
  widthStepMm  Int        @default(10)
  lengthMinMm  Int        @default(2000)
  lengthMaxMm  Int        @default(6000)
  lengthStepMm Int        @default(10)
  heightMinMm  Int        @default(2200)
  heightMaxMm  Int        @default(3000)
  heightStepMm Int        @default(10)
  dataStatus   DataStatus @default(UNKNOWN)
  updatedAt    DateTime   @updatedAt
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Grilles tarifaires sur mesure (versionnées, testables avant publication)
 */
/**
 * ------------------------------------------------------------------
 */

enum GridStatus {
  DRAFT
  TESTING
  PUBLISHED
  ARCHIVED
}

enum GridMode {
  /**
   * cellules largeur × longueur (table fournisseur)
   */
  TABLE
  /**
   * tranches dimensionnelles (bornes min/max)
   */
  BANDS
}

model PriceGrid {
  id             String               @id @default(cuid())
  familySlug     String
  name           String
  version        Int                  @default(1)
  status         GridStatus           @default(DRAFT)
  mode           GridMode             @default(TABLE)
  unit           String               @default("mm")
  currency       String               @default("EUR")
  validFrom      DateTime?
  validTo        DateTime?
  dataStatus     DataStatus           @default(DEMO)
  isDemo         Boolean              @default(true)
  source         String               @default("")
  widthMinMm     Int
  widthMaxMm     Int
  widthStepMm    Int                  @default(10)
  lengthMinMm    Int
  lengthMaxMm    Int
  lengthStepMm   Int                  @default(10)
  heightMinMm    Int
  heightMaxMm    Int
  heightStepMm   Int                  @default(10)
  mountings      String[]             @default([])
  finishCodes    String[]             @default([])
  notes          String               @default("")
  importFilename String?
  createdBy      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  cells          PriceGridCell[]
  surcharges     PriceGridSurcharge[]

  @@unique([familySlug, version])
  @@index([familySlug, status])
}

model PriceGridCell {
  id          String    @id @default(cuid())
  gridId      String
  grid        PriceGrid @relation(fields: [gridId], references: [id], onDelete: Cascade)
  widthMinMm  Int
  widthMaxMm  Int
  lengthMinMm Int
  lengthMaxMm Int
  mounting    String    @default("*")
  finishCode  String    @default("*")
  priceCents  Int

  @@index([gridId])
}

/**
 * Suppléments : finition, implantation, hauteur au-delà d'un seuil, fermeture par côté, option.
 */
model PriceGridSurcharge {
  id           String    @id @default(cuid())
  gridId       String
  grid         PriceGrid @relation(fields: [gridId], references: [id], onDelete: Cascade)
  code         String
  label        String
  kind         String
  match        String    @default("*")
  thresholdMm  Int?
  perStepMm    Int?
  perStepCents Int?
  priceCents   Int       @default(0)
  percentBps   Int       @default(0)
  sortOrder    Int       @default(0)

  @@index([gridId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Médias & documents
 */
/**
 * ------------------------------------------------------------------
 */

enum MediaNature {
  PHOTO
  RENDER
  ILLUSTRATION
  VIDEO
  DOCUMENT
}

enum MediaStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  REJECTED
}

model Media {
  id              String         @id @default(cuid())
  kind            String         @default("image")
  /**
   * photo réelle, rendu 3D, illustration, vidéo, document : jamais un rendu présenté comme une photo
   */
  nature          MediaNature    @default(ILLUSTRATION)
  status          MediaStatus    @default(DRAFT)
  path            String
  /**
   * vidéo hébergée ailleurs (URL https) ; sinon fichier local
   */
  externalUrl     String?
  alt             String         @default("")
  title           String         @default("")
  width           Int?
  height          Int?
  mimeType        String?
  sizeBytes       Int?
  source          String         @default("")
  license         String         @default("")
  credit          String         @default("")
  rightsNote      String         @default("")
  rightsExpiresAt DateTime?
  takenAt         DateTime?
  /**
   * options visibles sur l'image mais non comprises dans le prix affiché
   */
  visibleOptions  String         @default("")
  /**
   * paramètres du rendu (gamme, finition, implantation, équipements)
   */
  renderConfig    Json?
  /// provenance : fichier source + page, ou URL + date de récupération, modèle représenté, autorisation client
  provenance      Json?
  sortOrder       Int            @default(0)
  validatedBy     String?
  validatedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  products        ProductMedia[]
  documents       Document[]
  realisations    Realisation[]
}

model ProductMedia {
  id         String        @id @default(cuid())
  familyId   String
  mediaId    String
  role       String        @default("gallery")
  caption    String        @default("")
  sortOrder  Int           @default(0)
  /**
   * ciblage facultatif : variante, finition, implantation, équipements représentés
   */
  variantSku String?
  finishCode String?
  mounting   String?
  tags       String[]      @default([])
  context    Json?
  family     ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  media      Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([familyId, sortOrder])
}

enum DocumentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum DocumentAudience {
  PUBLIC
  CUSTOMER
  INTERNAL
}

/**
 * Document versionné (notice, fiche technique, certificat, garantie, guide). Un `groupKey` regroupe les versions.
 */
model Document {
  id             String                @id @default(cuid())
  groupKey       String                @default(cuid())
  version        Int                   @default(1)
  familyId       String?
  variantSku     String?
  mediaId        String?
  title          String
  kind           String                @default("notice")
  summary        String                @default("")
  status         DocumentStatus        @default(DRAFT)
  audience       DocumentAudience      @default(PUBLIC)
  dataStatus     DataStatus            @default(UNKNOWN)
  source         String                @default("")
  notes          String                @default("")
  validatedBy    String?
  validatedAt    DateTime?
  publishedAt    DateTime?
  createdBy      String?
  family         ProductFamily?        @relation(fields: [familyId], references: [id], onDelete: SetNull)
  media          Media?                @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  technicalSpecs TechnicalSpec[]
  validations    ReferenceValidation[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt

  @@unique([groupKey, version])
  @@index([familyId, status])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Configurations, paniers, devis, commandes
 */
/**
 * ------------------------------------------------------------------
 */

enum ConfigurationStatus {
  DRAFT
  VALID
  NEEDS_REVIEW
  QUOTE_REQUIRED
}

model Configuration {
  id              String              @id @default(cuid())
  shareToken      String              @unique
  shareRevoked    Boolean             @default(false)
  ownerUserId     String?
  owner           User?               @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  guestKey        String?
  kind            String
  title           String?
  version         Int                 @default(1)
  engineVersion   String
  catalogVersion  String
  input           Json
  result          Json
  status          ConfigurationStatus @default(DRAFT)
  parentId        String?
  lastValidatedAt DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  cartLines       CartLine[]
  quotes          Quote[]
  visuals         QuoteVisual[]

  @@index([ownerUserId])
  @@index([guestKey])
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model Cart {
  id            String     @id @default(cuid())
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestKey      String?
  status        CartStatus @default(ACTIVE)
  promotionCode String?
  delivery      Json?
  lines         CartLine[]
  orders        Order[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
  @@index([guestKey])
}

model CartLine {
  id              String         @id @default(cuid())
  cartId          String
  cart            Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  configurationId String?
  configuration   Configuration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  input           Json
  qty             Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   @default("")
  firstName   String
  lastName    String
  company     String?
  line1       String
  line2       String?
  postalCode  String
  city        String
  countryCode String   @default("FR")
  phone       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

enum QuoteStatus {
  NEW
  IN_REVIEW
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model Quote {
  id                 String         @id @default(cuid())
  number             String         @unique
  userId             String?
  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  email              String
  firstName          String
  lastName           String
  phone              String?
  postalCode         String?
  message            String?
  kind               String
  configurationId    String?
  configuration      Configuration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  snapshot           Json
  status             QuoteStatus    @default(NEW)
  validUntil         DateTime?
  adminNotes         String?
  proposedTotalCents Int?
  containsDemoData   Boolean        @default(true)
  /// attribution du prospect transmise avec la demande (utm_*, référent, page d'entrée) — jamais par cookie
  attribution        Json?
  /// qualification commerciale (à qualifier, qualifié, non qualifié) — indépendante du statut du devis
  qualification      String         @default("TO_QUALIFY")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  visuals            QuoteVisual[]

  @@index([userId])
  @@index([email])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  EXPIRED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                String             @id @default(cuid())
  number            String             @unique
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestKey          String?
  email             String
  status            OrderStatus        @default(PENDING_PAYMENT)
  fulfillmentStatus FulfillmentStatus  @default(UNFULFILLED)
  currency          String             @default("EUR")
  goodsCents        Int
  installationCents Int                @default(0)
  shippingCents     Int                @default(0)
  discountCents     Int                @default(0)
  taxCents          Int
  totalCents        Int
  shippingAddress   Json
  billingAddress    Json
  delivery          Json
  isDemo            Boolean            @default(true)
  containsDemoData  Boolean            @default(true)
  customerNotes     String?
  adminNotes        String?
  cartId            String?
  cart              Cart?              @relation(fields: [cartId], references: [id], onDelete: SetNull)
  lines             OrderLine[]
  payments          Payment[]
  reservations      StockReservation[]
  expiresAt         DateTime?
  paidAt            DateTime?
  /// devis approuvé à l'origine de la commande (paiement d'un devis) ; null = panier
  quoteId           String?
  /// paiement à examiner (ex. fonds reçus après expiration ou annulation de la commande) : jamais résolu automatiquement
  paymentReview     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([quoteId])
}

model OrderLine {
  id                    String  @id @default(cuid())
  orderId               String
  order                 Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind                  String
  sku                   String?
  label                 String
  qty                   Int
  unitGrossCents        Int
  totalGrossCents       Int
  taxRateBps            Int
  included              Boolean @default(false)
  configurationSnapshot Json?
  sortOrder             Int     @default(0)
}

enum PaymentProvider {
  DEMO
  STRIPE
  INSTALLMENTS_SIM
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      PaymentProvider
  providerRef   String?         @unique
  status        PaymentStatus   @default(CREATED)
  amountCents   Int
  currency      String          @default("EUR")
  checkoutUrl   String?
  failureReason String?
  /**
   * card | installments
   */
  method        String          @default("card")
  installments  Int?
  planProvider  String?
  feesCents     Int             @default(0)
  /// virement bancaire : session validée, fonds attendus (statut PENDING) ; instructions hébergées par le prestataire
  awaitingFundsSince DateTime?
  instructionsUrl    String?
  /// montant déjà reçu (virement partiel), en centimes
  amountReceivedCents Int?
  /// identifiant du compte prestataire et environnement (test / live) qui ont traité le paiement
  providerAccount    String?
  livemode           Boolean?
  events        PaymentEvent[]
  refunds       Refund[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([orderId])
}

model PaymentEvent {
  id          String          @id @default(cuid())
  paymentId   String?
  payment     Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider    PaymentProvider
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  outcome     String?
  receivedAt  DateTime        @default(now())

  @@unique([provider, eventId])
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountCents Int
  reason      String?
  status      String   @default("PENDING")
  providerRef String?
  createdAt   DateTime @default(now())
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

model StockReservation {
  id        String            @id @default(cuid())
  variantId String
  variant   Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  qty       Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([variantId, status])
  @@index([orderId])
}

