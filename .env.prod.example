# Copier en .env.prod (jamais commité). Utilisé par docker/compose.prod.yml.
POSTGRES_USER=elios
POSTGRES_PASSWORD=
POSTGRES_DB=elios_solar
APP_PORT=3400
IMAGE_TAG=latest
TRAEFIK_ENABLE=false
SITE_DOMAIN=
# Accès de revue derrière Traefik : une ligne htpasswd ENTRE APOSTROPHES (les $ ne doivent pas être interprétés),
# ex. générée par `openssl passwd -apr1`. Jamais commitée ; le mot de passe en clair se transmet hors de ce fichier.
REVIEW_BASIC_AUTH=
NEXT_PUBLIC_BRAND_NAME="HELIOSTORES"
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3400
SITE_INDEXABLE=false
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3400
# Proxys de confiance (adresses ou CIDR séparés par des virgules). Seuls ces pairs TCP peuvent transmettre
# X-Forwarded-For : la garde docker/xff-guard.cjs remplace l'en-tête de tout autre pair par son adresse réelle.
# Accès par tunnel SSH (port lié à 127.0.0.1) : passerelle du réseau elios_solar_internal, vue par l'app
#   docker network inspect elios_solar_internal -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# Derrière Traefik : l'adresse FIXE du conteneur Traefik (jamais le sous-réseau traefik-public entier,
# partagé avec d'autres conteneurs). Vide = aucun proxy de confiance. Le verrou par compte s'applique toujours.
TRUSTED_PROXIES=
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="HELIOSTORES <no-reply@example.invalid>"
ADMIN_NOTIFICATION_EMAIL=
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
DEMO_PAYMENT_WEBHOOK_SECRET=
LOG_LEVEL=info
