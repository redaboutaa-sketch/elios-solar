# Copier en .env.prod (jamais commité). Utilisé par docker/compose.prod.yml.
POSTGRES_USER=elios
POSTGRES_PASSWORD=
POSTGRES_DB=elios_solar
APP_PORT=3400
IMAGE_TAG=latest
TRAEFIK_ENABLE=false
SITE_DOMAIN=
NEXT_PUBLIC_BRAND_NAME="ELIOS SOLAR"
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3400
SITE_INDEXABLE=false
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3400
# Proxys de confiance (CIDR séparés par des virgules) quand l'app est derrière Traefik / un équilibreur
# qui AJOUTE l'IP cliente à X-Forwarded-For (ex. le sous-réseau du réseau docker traefik-public).
# Vide = aucune chaîne de proxys acceptée (port lié à 127.0.0.1). Le verrou par compte s'applique dans tous les cas.
TRUSTED_PROXIES=
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="ELIOS SOLAR <no-reply@example.invalid>"
ADMIN_NOTIFICATION_EMAIL=
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
DEMO_PAYMENT_WEBHOOK_SECRET=
LOG_LEVEL=info
