# ---- Copier en .env (jamais commité) ---------------------------------------
# Identité (provisoire) — modifiable aussi dans l'administration
NEXT_PUBLIC_BRAND_NAME="ELIOS SOLAR"
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3400"
# "false" en préproduction : noindex + pas de sitemap public
SITE_INDEXABLE="false"

# Base de données (PostgreSQL 16). Dev : docker/compose.dev.yml expose 127.0.0.1:5433
DATABASE_URL="postgresql://elios:elios_dev_only@127.0.0.1:5433/elios_solar?schema=public"

# Authentification (better-auth). Générer : openssl rand -base64 32
BETTER_AUTH_SECRET="remplacer-par-un-secret-de-32-caracteres-minimum"
BETTER_AUTH_URL="http://127.0.0.1:3400"

# E-mails transactionnels. Dev : Mailpit (SMTP 127.0.0.1:1025, UI http://127.0.0.1:8025)
MAIL_PROVIDER="smtp"               # smtp | log
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="ELIOS SOLAR <no-reply@elios-solar.local>"
ADMIN_NOTIFICATION_EMAIL="admin@elios-solar.local"

# Paiement. Sans clés Stripe : mode "demo" (paiement simulé, clairement affiché).
PAYMENT_PROVIDER="demo"            # demo | stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Secret HMAC du webhook de paiement démo (dev/test uniquement)
DEMO_PAYMENT_WEBHOOK_SECRET="demo-webhook-secret-change-me"

# Stockage des médias uploadés (chemin local, volume Docker en prod)
MEDIA_STORAGE_DIR="./uploads"

# Journalisation
LOG_LEVEL="info"

# Tests d'intégration (base dédiée, recréée par les tests) — facultatif en local
DATABASE_URL_TEST="postgresql://elios:elios_dev_only@127.0.0.1:5433/elios_solar_test?schema=public"

# Chat : assistant automatique FACULTATIF (sans ces variables, chat humain / différé uniquement)
AI_PROVIDER=""                     # "" | anthropic
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"
# Conservation des conversations (scripts/purge-conversations.ts)
CHAT_RETENTION_DAYS="180"
CHAT_INACTIVE_DAYS="365"

# Paiement fractionné (réglages en base : /admin/paiement). Simulateur : secret HMAC du webhook
# /api/webhooks/payment/installments-sim (dev/test uniquement ; à défaut, DEMO_PAYMENT_WEBHOOK_SECRET).
# Réel : Klarna ou Alma via Stripe Checkout (PAYMENT_PROVIDER=stripe + clés ci-dessus, moyen activé
# dans le Dashboard Stripe, compte marchand validé). Production = clé sk_live_ uniquement.
INSTALLMENTS_SIM_WEBHOOK_SECRET=""

# URL interne des appels serveur → serveur (webhooks simulés). Par défaut http://127.0.0.1:$PORT
# INTERNAL_APP_URL="http://127.0.0.1:3400"
