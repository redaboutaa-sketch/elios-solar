[Unit]
Description=HELIOSTORES — contrôle SEO quotidien (déterministe, sans LLM)
Documentation=file:///opt/pergola/seo/automation/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/heliostores-seo/daily_check.py
DynamicUser=yes
StateDirectory=heliostores-seo-daily
StandardOutput=journal
SyslogIdentifier=heliostores-seo-daily
TimeoutStartSec=10min
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
